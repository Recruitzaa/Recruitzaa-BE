# ============================================================
# Recruitzaa Backend — Environment Variables
# Copy this to .env and fill in real values
# ============================================================

# ─── PostgreSQL ───────────────────────────────────────────
POSTGRES_USER=recruitzaa
POSTGRES_PASSWORD=recruitzaa_secret
POSTGRES_DB=recruitzaa
# For local dev (outside Docker):
DATABASE_URL=postgresql+asyncpg://recruitzaa:recruitzaa_secret@localhost:5433/recruitzaa

# ─── MongoDB ──────────────────────────────────────────────
MONGO_USER=recruitzaa
MONGO_PASSWORD=mongo_secret
MONGO_DB=recruitzaa
MONGODB_URL=mongodb://recruitzaa:mongo_secret@localhost:27017/recruitzaa?authSource=admin

# ─── Redis ────────────────────────────────────────────────
REDIS_PASSWORD=redis_secret
REDIS_URL=redis://:redis_secret@localhost:6379/0

# ─── Kafka ────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── MinIO ────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minio_secret
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minio_secret
MINIO_BUCKET_RESUMES=resumes
MINIO_BUCKET_PROFILES=profile-photos
MINIO_USE_SSL=false

# ─── Firebase ─────────────────────────────────────────────
# Download from: Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# Place the file at: secrets/firebase-sa.json
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/firebase-sa.json

# ─── Resend (Email) ───────────────────────────────────────
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
EMAIL_FROM=noreply@recruitzaa.com

# ─── Application ──────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change_me_in_production_min_32_chars
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ─── AI / Ollama ──────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AI_DEFAULT_MODEL=ollama/gemma:2b
AI_FALLBACK_MODEL=openai/gpt-4o
AI_DAILY_TOKEN_BUDGET=50000

# ─── Admin ────────────────────────────────────────────────
# Comma-separated emails that get all 5 roles (staging/demo only)
ADMIN_EMAILS=sumanth@example.com

# ─── Adzuna Job Scraper ───────────────────────────────────
ADZUNA_APP_ID=XXXXXXXXXX
ADZUNA_API_KEY=XXXXXXXXXX
JOOBLE_API_KEY=XXXXXXXXXX

# ─── pgAdmin ──────────────────────────────────────────────
PGADMIN_EMAIL=admin@recruitzaa.dev
PGADMIN_PASSWORD=pgadmin_secret

# ─── Mongo Express ────────────────────────────────────────
MEXPRESS_USER=admin
MEXPRESS_PASSWORD=mexpress_secret
