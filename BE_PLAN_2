## 14. Full Docker Compose (v2 — Self-hosted VPS)

```yaml
# docker-compose.yml
version: "3.9"

services:
  # ── NGINX ──
  nginx:
    image: nginx:1.25-alpine
    ports: ["80:80", "443:443"]
    volumes:
      - ./infra/nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - nginx_certs:/etc/letsencrypt
    depends_on: [auth, core, ai, scraper, notification, analytics]
    restart: unless-stopped

  # ── APPLICATION SERVICES ──
  auth:
    build: ./services/auth_service
    environment:
      - POSTGRES_URL=${POSTGRES_URL}
      - REDIS_URL=${REDIS_URL}
      - FIREBASE_CREDENTIALS_JSON=${FIREBASE_CREDENTIALS_JSON}
    depends_on: [postgres, redis]
    restart: unless-stopped

  core:
    build: ./services/core_api_service
    environment:
      - MONGO_URL=${MONGO_URL}
      - REDIS_URL=${REDIS_URL}
      - KAFKA_BOOTSTRAP=${KAFKA_BOOTSTRAP}
      - MINIO_ENDPOINT=${MINIO_ENDPOINT}
    depends_on: [mongo, redis, kafka]
    restart: unless-stopped

  ai:
    build: ./services/ai_service
    environment:
      - OPENAI_API_KEY=${OPENAI_API_KEY}
      - OLLAMA_HOST=${OLLAMA_HOST}
      - MONGO_URL=${MONGO_URL}
      - REDIS_URL=${REDIS_URL}
    depends_on: [mongo, redis, ollama]
    restart: unless-stopped

  scraper:
    build: ./services/scraper_service
    environment:
      - MONGO_URL=${MONGO_URL}
      - REDIS_URL=${REDIS_URL}
      - KAFKA_BOOTSTRAP=${KAFKA_BOOTSTRAP}
      - ADZUNA_API_KEY=${ADZUNA_API_KEY}
    depends_on: [mongo, redis, kafka]
    restart: unless-stopped

  notification:
    build: ./services/notification_service
    environment:
      - KAFKA_BOOTSTRAP=${KAFKA_BOOTSTRAP}
      - RESEND_API_KEY=${RESEND_API_KEY}
      - FIREBASE_CREDENTIALS_JSON=${FIREBASE_CREDENTIALS_JSON}
    depends_on: [kafka]
    restart: unless-stopped

  analytics:
    build: ./services/analytics_service
    environment:
      - POSTGRES_URL=${POSTGRES_URL}
      - MONGO_URL=${MONGO_URL}
      - KAFKA_BOOTSTRAP=${KAFKA_BOOTSTRAP}
    depends_on: [postgres, mongo, kafka]
    restart: unless-stopped

  admin:
    build: ./services/admin_service
    environment:
      - POSTGRES_URL=${POSTGRES_URL}
      - MONGO_URL=${MONGO_URL}
      - KAFKA_BOOTSTRAP=${KAFKA_BOOTSTRAP}
    depends_on: [postgres, mongo]
    restart: unless-stopped

  # ── CELERY WORKERS ──
  celery_ai:
    build: ./services/ai_service
    command: celery -A app.workers.celery_app worker -Q ai_tasks -c 2 --loglevel=info
    environment:
      - OPENAI_API_KEY=${OPENAI_API_KEY}
      - OLLAMA_HOST=${OLLAMA_HOST}
      - MONGO_URL=${MONGO_URL}
    depends_on: [redis, mongo, ollama]
    restart: unless-stopped

  celery_scraper:
    build: ./services/scraper_service
    command: celery -A app.workers.celery_app worker -Q scrape_tasks -c 4 --loglevel=info
    environment:
      - MONGO_URL=${MONGO_URL}
      - REDIS_URL=${REDIS_URL}
      - KAFKA_BOOTSTRAP=${KAFKA_BOOTSTRAP}
    depends_on: [redis, mongo, kafka]
    restart: unless-stopped

  celery_beat:
    build: ./services/scraper_service
    command: celery -A app.workers.celery_app beat --loglevel=info
    depends_on: [redis]
    restart: unless-stopped

  # ── DATABASES ──
  postgres:
    image: postgres:16-alpine
    environment:
      POSTGRES_DB: recruitzaa
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
    volumes: [postgres_data:/var/lib/postgresql/data]
    restart: unless-stopped

  mongo:
    image: mongo:7
    environment:
      MONGO_INITDB_ROOT_USERNAME: ${MONGO_USER}
      MONGO_INITDB_ROOT_PASSWORD: ${MONGO_PASSWORD}
    volumes: [mongo_data:/data/db]
    restart: unless-stopped

  redis:
    image: redis:7-alpine
    command: redis-server --maxmemory 512mb --maxmemory-policy allkeys-lru
    volumes: [redis_data:/data]
    restart: unless-stopped

  # ── KAFKA (KRaft mode — no Zookeeper) ──
  kafka:
    image: confluentinc/cp-kafka:7.6.0
    environment:
      KAFKA_NODE_ID: 1
      KAFKA_PROCESS_ROLES: broker,controller
      KAFKA_LISTENERS: PLAINTEXT://0.0.0.0:9092,CONTROLLER://0.0.0.0:9093
      KAFKA_ADVERTISED_LISTENERS: PLAINTEXT://kafka:9092
      KAFKA_CONTROLLER_QUORUM_VOTERS: 1@kafka:9093
      KAFKA_LOG_RETENTION_HOURS: 168       # 7 days
      KAFKA_AUTO_CREATE_TOPICS_ENABLE: "true"
    volumes: [kafka_data:/var/lib/kafka/data]
    restart: unless-stopped

  # ── MINIO (Self-hosted File Storage) ──
  minio:
    image: minio/minio:latest
    command: server /data --console-address ":9001"
    ports: ["9001:9001"]   # MinIO web UI (not exposed publicly, only internal)
    environment:
      MINIO_ROOT_USER: ${MINIO_USER}
      MINIO_ROOT_PASSWORD: ${MINIO_PASSWORD}
    volumes: [minio_data:/data]
    restart: unless-stopped

  # ── OLLAMA (Local LLM) ──
  ollama:
    image: ollama/ollama:latest
    volumes: [ollama_data:/root/.ollama]
    # GPU support: add `deploy.resources.reservations.devices` for NVIDIA
    restart: unless-stopped

  # ── OBSERVABILITY ──
  prometheus:
    image: prom/prometheus:latest
    volumes:
      - ./infra/observability/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus_data:/prometheus
    restart: unless-stopped

  grafana:
    image: grafana/grafana:latest
    ports: ["3001:3000"]    # Grafana UI (secured behind auth)
    environment:
      GF_SECURITY_ADMIN_PASSWORD: ${GRAFANA_PASSWORD}
    volumes:
      - grafana_data:/var/lib/grafana
      - ./infra/observability/grafana/dashboards:/etc/grafana/provisioning/dashboards:ro
    depends_on: [prometheus, loki, tempo]
    restart: unless-stopped

  loki:
    image: grafana/loki:latest
    volumes: [loki_data:/loki]
    restart: unless-stopped

  promtail:
    image: grafana/promtail:latest
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro   # reads container logs
    restart: unless-stopped

  tempo:
    image: grafana/tempo:latest
    volumes: [tempo_data:/tmp/tempo]
    restart: unless-stopped

volumes:
  postgres_data:
  mongo_data:
  redis_data:
  kafka_data:
  minio_data:
  ollama_data:
  prometheus_data:
  grafana_data:
  loki_data:
  tempo_data:
  nginx_certs:
