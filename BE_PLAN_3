## 7. NGINX Config (v3 — HashRouter Optimized)

  server {
      listen 443 ssl;
      server_name staging.recruitzaa.com;

      # API PROXIES
      location /api/auth/        { proxy_pass http://auth:8001/;        }
      location /api/ai/          { proxy_pass http://ai:8003/;          }
      location /api/scraper/     { proxy_pass http://scraper:8004/;     }
      location /api/notifications/ { proxy_pass http://notification:8005/; }
      location /api/analytics/   { proxy_pass http://analytics:8006/;   }
      location /api/admin/       { proxy_pass http://admin:8007/;       }
      location /api/             { proxy_pass http://core:8002/;        }

      # WebSocket for real-time notifications
      location /api/notifications/ws {
          proxy_pass http://notification:8005/notifications/ws;
          proxy_http_version 1.1;
          proxy_set_header Upgrade $http_upgrade;
          proxy_set_header Connection "upgrade";
      }

      # FRONTEND SPA (HashRouter)
      # Because FE uses HashRouter, ALL non-API requests serve index.html.
      # The browser handles /#/candidate/dashboard entirely client-side.
      root /usr/share/nginx/html;
      index index.html;

      location / {
          try_files $uri $uri/ /index.html;
      }
  }

